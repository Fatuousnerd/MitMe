{
  "name": "@fatuousnerd/mitme",
  "version": "2.0.0",
  "description": "Video Conferencing tool that uses WebRTC through PeerJS",
  "private": false,
  "license": "MIT",
  "lib": [
    "DOM",
    "ESNext"
  ],
  "scripts": {
    "build": "tsup"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fatuousnerd/MitMe.git"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "zod": "^4.4.3"
  },
  "keywords": [
    "sdk",
    "api",
    "typescript",
    "webrtc",
    "video-conferencing",
    "video"
  ],
  "author": "Fatuous Nerd",
  "homepage": "https://github.com/Fatuousnerd/MitMe",
  "bugs": {
    "url": "https://github.com/Fatuousnerd/MitMe/issues"
  }
}
